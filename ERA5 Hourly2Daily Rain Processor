// =============================================
// 7) Export to CSV
// =============================================
Export.table.toDrive({
  collection: stationDailyRain,
  description: "ERA5_Daily_Stations_Vanuatu",
  fileFormat: "CSV"
});

// =============================================
// 8) VISUALIZATION SECTION (CLIPPED)
// =============================================
// 1. Create the overall cumulative map for the period (converted to mm)
var totalPeriodRainfall = ee.ImageCollection('ECMWF/ERA5/HOURLY')
                            .filterDate(startDate, endDate)
                            .select('total_precipitation')
                            .sum()
                            .multiply(1000); 

// 2. CRITICAL CHANGE: Clip the rainfall image using your geometry
// (Assumes your boundary layer variable is called 'geometry')
var clippedRainfall = totalPeriodRainfall.clip(geometry);

// Define visualization parameters
