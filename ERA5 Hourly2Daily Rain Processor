// =============================================
// 1) Load station layer (must have "name" field)
// =============================================
var rawStations = ee.FeatureCollection("projects/ee-glagudo/assets/Vanuatu_VMGDStations_Final01");

// Force every station to be a true point
var stations = rawStations.map(function(f) {
  return ee.Feature(f.geometry().centroid(1), f.toDictionary());
});

// =============================================
// 2) Set temporal range
// =============================================
var startDate = ee.Date('1970-01-01');
var endDate   = ee.Date('2000-12-30');

// =============================================
// 3) Load ERA5 Hourly and aggregate to DAILY
// =============================================
var numberOfDays = endDate.difference(startDate, 'days');

var dailyImagesList = ee.List.sequence(0, numberOfDays.subtract(1)).map(function(dayOffset) {
  var start = startDate.advance(dayOffset, 'days');
  var end = start.advance(1, 'days');
  
  var dailySum = ee.ImageCollection('ECMWF/ERA5/HOURLY')
                   .filterDate(start, end)
                   .select('total_precipitation')
                   .sum(); 
                   
  return dailySum.set({
    'system:time_start': start.millis(),
    'date_string': start.format('YYYY-MM-dd')
  });
});

var era5Daily = ee.ImageCollection(dailyImagesList);

// =============================================
// 4) Extract daily rainfall per station
// =============================================
var extractDailyRain = function(image) {
  var date = image.get('date_string');

  var sampled = image.reduceRegions({
    collection: stations,
    reducer: ee.Reducer.first(),
    scale: 27830                      
  });

  return sampled.map(function(f) {
    var rainMeters = ee.Number(f.get("first"));
    var rainMm = ee.Algorithms.If(rainMeters, rainMeters.multiply(1000), 0);

    return f.set({
      "date": date,
      "precipitation_mm": rainMm
    })
    .select(["name", "date", "precipitation_mm"]);
  });
};

// =============================================
// 5) Apply to all days
// =============================================
var stationDailyRain = era5Daily.map(extractDailyRain).flatten();

// =============================================
// 6) DEBUG: show first 20 rows
// =============================================
//print(
